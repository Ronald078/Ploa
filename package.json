{
  "name": "prospeccao-de-leads",
  "private": true,
  "scripts": {
    "crm": "node crm/server.js",
    "crm:app": "electron crm/desktop.js",
    "crm:app:accounts": "electron crm/desktop-accounts.js",
    "crm:resumo": "node crm/scripts/crm_cli.js resumo",
    "crm:next:build": "npm --prefix crm/app-next run build",
    "crm:cloud:build": "npm --prefix crm/app-next run build:cloud",
    "crm:cloud:preview": "node --env-file=crm/cloud/.env crm/cloud/server.js",
    "crm:accounts:preview": "node --env-file=crm/cloud/.env crm/cloud/local-preview.js",
    "test:crm": "node --test crm/test/*.test.js",
    "crm:cloud:check": "node --env-file=crm/cloud/.env crm/cloud/check-readiness.js",
    "crm:cloud:package": "node crm/cloud/build-server-package.js",
    "crm:desktop:installer": "node crm/tools/prepare-desktop.js",
    "crm:cloud:worker:check": "node crm/tools/worker-cli.js check",
    "crm:cloud:worker:deploy": "node crm/tools/worker-cli.js deploy"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "nodemailer": "10.3.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@napi-rs/keyring": "1.3.0",
    "electron": "^44.4.3",
    "electron-builder": "26.18.0",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "electron@44.4.3": true
  }
}
