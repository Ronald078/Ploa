# Server-only environment. Do not put these values in React/VITE variables or the desktop/mobile agent.
PLOA_SERVER_MODE=production
PLOA_STATE_MODE=shared
PLOA_PUBLIC_ORIGIN=https://REPLACE-WITH-PUBLIC-HOST
PORT=3000
PLOA_SUPABASE_URL=https://YOUR-PLOA-PROJECT.supabase.co
PLOA_SUPABASE_PUBLISHABLE_KEY=
PLOA_SUPABASE_SERVER_KEY=
# A persistent, identical 32-byte base64 key for all server instances; keep a private backup.
PLOA_SERVER_STATE_KEY=
PLOA_EMAIL_PROVIDER=gmail
PLOA_GMAIL_USER=
PLOA_GMAIL_APP_PASSWORD=
# Optional alternative, only when explicitly selected/configured.
PLOA_RESEND_API_KEY=
PLOA_EMAIL_FROM=
