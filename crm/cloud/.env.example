# Separate Ploa project only; never use the ConectaLook project here.
PLOA_SUPABASE_URL=https://YOUR-PLOA-PROJECT.supabase.co
PLOA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
PLOA_CLOUD_PORT=4313
# Preview stays loopback-only/local unless explicitly changed. Never ship these secrets with agents.
PLOA_SERVER_MODE=preview
PLOA_STATE_MODE=local
# For a future HTTPS server: production + shared, exact public origin and environment secrets.
PLOA_PUBLIC_ORIGIN=
PLOA_SERVER_STATE_KEY=
# Server only. Prefer Configurar seguranca do Ploa.vbs on this Windows preview.
# For hosting use a secret env variable. NEVER put it in Vite/browser/distributed agents.
PLOA_SUPABASE_SERVER_KEY=
PLOA_RESEND_API_KEY=
PLOA_EMAIL_FROM=
# Gmail: prefer saving the app password with Configurar Gmail do Ploa.vbs (Windows protection).
PLOA_EMAIL_PROVIDER=gmail
PLOA_GMAIL_USER=contato.ploa@gmail.com
# Optional server environment alternative; never use a normal Google account password.
PLOA_GMAIL_APP_PASSWORD=
